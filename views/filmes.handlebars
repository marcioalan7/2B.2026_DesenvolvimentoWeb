<h1>Lista de Filmes</h1>

{{#if logado}}

  <p>Usuário autenticado</p>

{{else}}

  <p>Usuário não autenticado</p>

{{/if}}

{{#unless admin}}

  <p>Você não é administrador</p>

{{/unless}}

<ul>

  {{#each filmes}}

    <li>
      {{this.nome}}
      -
      {{this.ano}}
    </li>

  {{/each}}

</ul>